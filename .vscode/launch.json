{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run experiment",
            "type": "debugpy",
            "request": "launch",
            "module": "experiments.run",
            "args": [
                "--scenarios", "baseline",
                "--mazes", "1",
                "--n-runs", "1",
                "--model", "gpt-4o-mini",
                "--provider", "openai",
                "--no-db"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}